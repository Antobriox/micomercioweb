# Configura estas variables únicamente con un proyecto de prueba aislado.
# Conserva la configuración de cada entorno en el proveedor de despliegue.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Opcional y solo de servidor. Habilita pedidos ficticios en la base aislada.
SUPABASE_DEMO_WRITER_KEY=

# Origen autorizado al que regresan los enlaces de recuperación.
APP_ORIGIN=http://localhost:3000
